{
  "name": "unpackingtheworld",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/icons.mjs && node scripts/prerender.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json --noEmit",
    "test": "node --experimental-strip-types --test src/lib/unpackers/*.test.ts src/lib/archive/*.test.ts src/lib/*.test.ts worker/*.test.ts",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "support:lookup": "node scripts/support-lookup.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/svelte": "0.1.0-beta.13",
    "cron-parser": "5.10.6",
    "cronstrue": "3.43.0",
    "fflate": "0.8.3",
    "svelte": "5.58.0",
    "ua-parser-js": "2.0.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261120.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "wrangler": "4.165.0"
  }
}
