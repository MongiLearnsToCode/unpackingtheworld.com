{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unpackingtheworld",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-20",
  "upload_source_maps": true,
  "workers_dev": true,
  "routes": [
    {
      "pattern": "unpackingtheworld.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "kv_namespaces": [
    {
      "binding": "LICENSES",
      "id": "ee3a8197a4bd44889e842d1716c8db9f"
    }
  ],
  "observability": {
    "enabled": true
  }
}
